        data-scopes="apps all"
        data-search="{{ c.name }} {{ c.title }} {{ c.category }} {{ (c.description or '') | replace('<br>', ' ') | replace('`', '') }}">
        <div class="fleet-card__header">
          <div class="fleet-card__logo">
            {%- if c.logo_dark %}
            <img src="/images/logos/{{ c.logo }}#only-light" alt="{{ c.title }}" loading="lazy" class="no-glb">
            <img src="/images/logos/{{ c.logo_dark }}#only-dark" alt="{{ c.title }}" loading="lazy" class="no-glb">
            {%- elif c.logo %}
            <img src="/images/logos/{{ c.logo }}" alt="{{ c.title }}" loading="lazy" class="no-glb">
            {%- else %}
            <svg class="fleet-card__fallback-icon" aria-hidden="true"><use xlink:href="#ico-cube"></use></svg>
            {%- endif %}
          </div>
          <div class="fleet-card__headings">
            <a class="fleet-card__title" href="{{ c.name }}/">{{ c.title }}</a>
            <div class="fleet-card__subrow">
              <span class="fleet-card__category">{{ c.category }}</span>
              <span class="fleet-badge fleet-badge--deprecated">Deprecated</span>
            </div>
          </div>
        </div>

        <p class="fleet-card__desc">{{ (c.description or '') | replace('<br>', ' ') | replace('`', '') }} — Deprecated: {{ c.deprecated.reason }}</p>

        <div class="fleet-card__footer">
          <div class="fleet-card__links">
            <a href="{{ c.repo_url }}" target="_blank" rel="noopener" class="fleet-card__icon-link" title="GitHub Repository" aria-label="{{ c.title }} GitHub Repository">
              <svg aria-hidden="true"><use xlink:href="#ico-github"></use></svg>
            </a>
            <a href="{{ c.repo_url }}/commits" target="_blank" rel="noopener" class="fleet-card__date" title="Last updated {{ c.last_update }}">{{ c.last_update }}</a>
          </div>
          <span class="fleet-card__details" aria-hidden="true">
            Details
            <svg aria-hidden="true"><use xlink:href="#ico-arrow"></use></svg>
          </span>
        </div>
      </article>
    {%- endfor %}
    </div>
  </div>
  {% endif %}
</div>

