  {% if cat in present_cats %}
    {% set _ = ordered_cats.append(cat) %}
  {% endif %}
{% endfor %}
{% for cat in present_cats | sort %}
  {% if cat not in ordered_cats and cat != 'Base' %}
    {% set _ = ordered_cats.append(cat) %}
  {% endif %}
{% endfor %}

{%- set apps_top = [] %}
{%- set stacks_top = [] %}
{%- set appliances_top = [] %}
{%- set base_cli_top = [] %}
{%- for c in active_configs %}
  {%- set is_base_or_cli = (c.type == 'base' or c.image_class in ['base', 'cli']) %}
  {%- if is_base_or_cli %}
    {%- set _ = base_cli_top.append(c) %}
  {%- else %}
    {%- if not c.part_of %}
      {%- set _ = apps_top.append(c) %}
    {%- endif %}
    {%- if c.type == 'stack' or c.is_stack %}
      {%- set _ = stacks_top.append(c) %}
    {%- endif %}
    {%- if c.type == 'appliance' %}
      {%- set _ = appliances_top.append(c) %}
    {%- endif %}
  {%- endif %}
{%- endfor %}

