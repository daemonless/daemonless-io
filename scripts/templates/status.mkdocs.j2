<div id="fleet-cards-view" class="fleet-view-section">
  <div class="fleet-grid" id="fleet-active-grid">
  {%- for c in active_configs | sort(attribute='title') %}
    {%- set choice_ids = (c.choices or []) | map(attribute='id') | list %}
    {%- set is_base_or_cli = (c.type == 'base' or c.image_class in ['base', 'cli']) %}
    {%- set scopes = ['all'] %}
    {%- if is_base_or_cli %}
      {%- set _ = scopes.append('base') %}
    {%- else %}
      {%- set _ = scopes.append('apps') %}
      {%- if c.type == 'stack' or c.is_stack %}{%- set _ = scopes.append('stacks') %}{%- endif %}
      {%- if c.type == 'appliance' %}{%- set _ = scopes.append('appliances') %}{%- endif %}
    {%- endif %}
    {%- set child_info = folded_children.get(c.name) %}
    {%- set tags_str = (c.image_tags or []) | join(' ') %}
    <article class="fleet-card{% if c.part_of %} fleet-card--part{% endif %}"
      data-app="{{ c.name }}"
      data-category="{{ c.category }}"
      data-scopes="{{ scopes | join(' ') }}"
      {% if c.part_of %}data-part-of="{{ c.part_of }}" hidden{% endif %}
      data-search="{{ c.name }} {{ c.title }} {{ c.category }} {{ tags_str }} {{ (c.description or '') | replace('<br>', ' ') | replace('`', '') }} {{ child_info.names | join(' ') if child_info else '' }}">
      <div class="fleet-card__header">
        <div class="fleet-card__logo">
          {%- if c.logo_dark %}
          <img src="/images/logos/{{ c.logo }}#only-light" alt="{{ c.title }}" loading="lazy" class="no-glb">
          <img src="/images/logos/{{ c.logo_dark }}#only-dark" alt="{{ c.title }}" loading="lazy" class="no-glb">
          {%- elif c.logo %}
          <img src="/images/logos/{{ c.logo }}" alt="{{ c.title }}" loading="lazy" class="no-glb">
          {%- else %}
          <svg class="fleet-card__fallback-icon" aria-hidden="true"><use xlink:href="#ico-cube"></use></svg>
          {%- endif %}
        </div>
        <div class="fleet-card__headings">
          <a class="fleet-card__title" href="{{ c.name }}/">{{ c.title }}</a>
          <div class="fleet-card__subrow">
            <span class="fleet-card__category">{{ c.category }}</span>
            {%- if c.type == 'stack' or c.is_stack %}
            <span class="fleet-badge fleet-badge--stack">Stack</span>
            {%- elif c.type == 'appliance' %}
            <span class="fleet-badge fleet-badge--appliance">Appliance</span>
            {%- elif c.type == 'base' or c.image_class == 'base' %}
            <span class="fleet-badge fleet-badge--base">Base</span>
            {%- elif c.image_class == 'cli' %}
            <span class="fleet-badge fleet-badge--cli">CLI</span>
            {%- endif %}
            {%- if c.part_of %}
            <span class="fleet-badge fleet-badge--part">Part of {{ c.part_of }}</span>
            {%- endif %}
            {%- if 'database' in choice_ids %}
            <span class="fleet-badge fleet-badge--choice">Multi-DB</span>
            {%- elif choice_ids %}
            <span class="fleet-badge fleet-badge--choice">Configurable</span>
            {%- endif %}
          </div>
        </div>
      </div>

      <p class="fleet-card__desc">{{ (c.description or '') | replace('<br>', ' ') | replace('`', '') }}</p>

      <div class="fleet-card__footer">
        <div class="fleet-card__links">
          <a href="{{ c.repo_url }}" target="_blank" rel="noopener" class="fleet-card__icon-link" title="GitHub Repository" aria-label="{{ c.title }} GitHub Repository">
            <svg aria-hidden="true"><use xlink:href="#ico-github"></use></svg>
          </a>
          {%- if c.upstream_url %}
          <a href="{{ c.upstream_url }}" target="_blank" rel="noopener" class="fleet-card__icon-link" title="Upstream Project" aria-label="{{ c.title }} Upstream Project">
            <svg aria-hidden="true"><use xlink:href="#ico-ext"></use></svg>
          </a>
          {%- endif %}
          <a href="{{ c.repo_url }}/commits" target="_blank" rel="noopener" class="fleet-card__date" title="Last updated {{ c.last_update }}">{{ c.last_update }}</a>
          {%- if child_info %}
          <button type="button" class="fleet-expand-btn" data-expand-parent="{{ c.name }}" data-count="{{ child_info.count }}" data-noun="{{ child_info.noun }}" aria-expanded="false" title="Show individual {{ child_info.noun }} in this suite">
            +{{ child_info.count }} {{ child_info.noun }} ▾
          </button>
          {%- endif %}
        </div>
        <span class="fleet-card__details" aria-hidden="true">
          Details
          <svg aria-hidden="true"><use xlink:href="#ico-arrow"></use></svg>
        </span>
      </div>
    </article>
  {%- endfor %}
  </div>

  {% if deprecated_configs %}
  <div class="fleet-deprecated-section" id="fleet-deprecated-cards-section">
    <h2 class="fleet-section-heading">Deprecated Images</h2>
    <p class="fleet-section-desc">The following images are no longer actively maintained.</p>
    <div class="fleet-grid" id="fleet-deprecated-grid">
    {%- for c in deprecated_configs | sort(attribute='title') %}
      <article class="fleet-card fleet-card--deprecated"
        data-app="{{ c.name }}"
