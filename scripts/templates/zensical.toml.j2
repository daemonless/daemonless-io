# Zensical configuration for daemonless.io documentation.
#
# THIS FILE IS THE SOURCE OF TRUTH. zensical.toml is auto-generated from it by
# scripts/generate_docs.py (make generate) and is gitignored. Edit THIS file.
#
# Build with:  make build

[project]
site_name = "daemonless"
site_url = "https://daemonless.io"
site_description = "Native FreeBSD OCI Containers - Jails without the System Administration"
repo_url = "https://github.com/daemonless/daemonless"
repo_name = "daemonless/daemonless"
edit_uri = "edit/main/docs/"
site_dir = "site"
# The Podman tab icon is from selfh.st/icons, CC BY 4.0: the credit it asks for.
copyright = 'Icons: <a href="https://selfh.st/icons/">selfh.st</a> (CC BY 4.0)'

extra_css = [
  "stylesheets/extra.css",
  "stylesheets/ux-overrides.css",
  # zip-bundle (Zensical: load assets directly, no plugin)
  "https://cdn.jsdelivr.net/gh/daemonless/mkdocs-zip-bundle-plugin@v0.3.0/mkdocs_zip_bundle/assets/zip-bundle.css",
]

extra_javascript = [
  "javascripts/ux-settings-v2.js",
  "javascripts/deploy-choices.js",
  "javascripts/demo-video.js",
  "https://unpkg.com/tablesort@5.3.0/dist/tablesort.min.js",
  "javascripts/tablesort.js",
  # zip-bundle (Zensical: load assets directly, no plugin)
  "https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js",
  "https://cdn.jsdelivr.net/gh/daemonless/mkdocs-zip-bundle-plugin@v0.3.0/mkdocs_zip_bundle/assets/zip-bundle.js",
]

# 7-tab operator-first information architecture.
nav = [
  { "Home" = "index.md" },
  { "Catalog" = [
    "images/index.md",
{%- for grp in image_nav_groups %}
    { "{{ grp.category }}" = [
{%- for c in grp.entries %}
      { "{{ c.title }}" = "images/{{ c.name }}.md" },
{%- endfor %}
    ] },
{%- endfor %}
  ] },
  { "Appliances" = [
    { "Daemonless Appliances" = "guides/appliances.md" },
    { "Reverse Proxy" = [
      "reverse-proxy/index.md",
      { "Host & First-Run Setup" = "reverse-proxy/setup.md" },
      { "Certificates, DNS & Access" = "reverse-proxy/certificates-and-access.md" },
      { "fjord, Container Labels & API" = "reverse-proxy/automation.md" },
      { "Backups & Troubleshooting" = "reverse-proxy/operations.md" },
    ] },
    { "Package Cache" = [
      "pkg-cache/index.md",
      { "Host Setup, ZFS & Sizing" = "pkg-cache/setup.md" },
      { "Hosts, Jails & Container Builds" = "pkg-cache/clients.md" },
      { "Mirrors, Stats & Troubleshooting" = "pkg-cache/mirrors-and-operations.md" },
    ] },
  ] },
  { "Documentation" = [
    { "Getting Started" = [
      { "Quick Start" = "guides/quick-start.md" },
      { "Permissions (PUID/PGID)" = "guides/permissions.md" },
      { "Jail Permissions (allow.*)" = "guides/ocijail-patch.md" },
    ] },
    { "Operations" = [
      { "Networking & VLANs" = "guides/networking.md" },
      { "ZFS Storage" = "guides/zfs.md" },
      { "Hardware Transcoding" = "guides/hardware-transcoding.md" },
      { "Updates & Maintenance" = "guides/operations.md" },
    ] },
    { "Architecture & Security" = [
      { "Image Architecture" = "architecture.md" },
      { "SBOMs & Provenance" = "sbom.md" },
      { "Philosophy" = "philosophy.md" },
    ] },
    { "Troubleshooting" = [
      { "Stalwart & ClamAV Integration" = "guides/stalwart-clamav.md" },
    ] },
    { "Community" = "community.md" },
    { "LLM / AI Policy" = "guides/llm-policy.md" },
  ] },
  { "Porting & dbuild" = [
    { "Contributor Quickstart" = "guides/contributing-quickstart.md" },
    { "Development Guide" = "guides/development.md" },
    { "Service Anatomy" = "guides/service-anatomy.md" },
    { "Stack Choices" = "guides/stack-choices.md" },
    { "Image Tagging" = "guides/tagging.md" },
    { "OCI Compliance" = "guides/oci-compliance.md" },
    { "AI-Assisted Porting" = "guides/ai-assisted-porting.md" },
    { "dbuild Toolchain" = [
      { "Overview" = "guides/dbuild/index.md" },
      { "Building Your First Image" = "guides/dbuild/workflow.md" },
      { "Command Reference" = "guides/dbuild/commands.md" },
      { "Configuration" = "guides/dbuild/config.md" },
      { "CI/CD Pipeline" = "guides/dbuild/ci.md" },
      { "Debugging a Failed CI Build" = "guides/dbuild/debugging-ci.md" },
      { "Linux Pre-Build Artifacts" = "guides/dbuild/linux-pre-build.md" },
      { "Quality Gates (CIT)" = "guides/dbuild/cit.md" },
    ] },
  ] },
  { "Status" = "status.md" },
  { "fjord" = "https://fjord.daemonless.io" },
]

[project.theme]
variant = "modern"
custom_dir = "overrides"
logo = "assets/daemonless-logo.svg"
favicon = "assets/favicon.ico"
features = [
  "navigation.tabs",
  "navigation.tabs.sticky",
  "navigation.top",
  "navigation.tracking",
  "navigation.path",
  "navigation.indexes",
  "navigation.instant",
  "navigation.instant.progress",
  "navigation.instant.preview",
  "navigation.instant.prefetch",
  "search.highlight",
  "search.suggest",
  "search.share",
  "toc.follow",
  "content.code.copy",
  "content.code.select",
  "content.code.annotate",
  "content.action.copy",
  "content.action.view",
  "content.tabs.link",
  "content.tooltips",
  "content.footnote.tooltips",
  "navigation.footer",
]

[[project.theme.palette]]
media = "(prefers-color-scheme: dark)"
scheme = "slate"
primary = "red"
accent = "red"
toggle.icon = "material/brightness-7"
toggle.name = "Switch to light mode"

[[project.theme.palette]]
media = "(prefers-color-scheme: light)"
scheme = "default"
primary = "red"
accent = "red"
toggle.icon = "material/brightness-4"
toggle.name = "Switch to dark mode"

[project.extra]
generator = false

[project.extra.analytics]
provider = "google"
property = "G-Z0TYZ35R6G"

[[project.extra.social]]
icon = "fontawesome/brands/github"
link = "https://github.com/daemonless"
name = "GitHub"

[[project.extra.social]]
icon = "material/check-circle"
link = "/status/"
name = "Build & Version Status"

[[project.extra.social]]
icon = "fontawesome/brands/discord"
link = "https://discord.com/invite/Kb9tkhecZT"
name = "Discord Community"

[project.plugins]
search = {}
social = { cards_layout_options = { background_color = "#1e1e24" } }
glightbox = { auto = true, auto_themed = true, auto_caption = true, skip_classes = ["no-glb", "app-icon", "app-logo-col"] }
gh-admonitions = {}

[project.plugins.privacy]
assets_include = [
  "fonts.googleapis.com/*",
  "fonts.gstatic.com/*",
  "unpkg.com/*",
  "cdn.jsdelivr.net/*",
]

[project.plugins.redirects.redirect_maps]
"fjord/index.md" = "https://fjord.daemonless.io/"
{%- if "overseerr" not in (generated_names | default([])) %}
"images/overseerr.md" = "images/seerr.md"
{%- endif %}

[project.plugins.llmstxt]
full_output = "llms-full.txt"
markdown_description = "FreeBSD-native OCI containers, multi-service stacks, and network appliances built on ocijail, Podman, AppJail, and fjord."

[project.plugins.llmstxt.sections]
"Getting Started & Operations" = ["guides/quick-start.md", "guides/permissions.md", "guides/zfs.md", "guides/networking.md", "guides/hardware-transcoding.md", "guides/ocijail-patch.md", "guides/operations.md"]
"Appliances & Architecture" = ["guides/appliances.md", "reverse-proxy/*.md", "pkg-cache/*.md", "architecture.md", "sbom.md", "philosophy.md"]
"Porting & dbuild" = ["guides/contributing-quickstart.md", "guides/development.md", "guides/service-anatomy.md", "guides/stack-choices.md", "guides/tagging.md", "guides/oci-compliance.md", "guides/ai-assisted-porting.md", "guides/dbuild/*.md"]
"Image Catalog" = ["images/*.md"]

# Markdown extensions — attr_list is REQUIRED for zip-bundle to read the
# data-zip-* attributes on code blocks.
[project.markdown_extensions.tables]
[project.markdown_extensions.admonition]
[project.markdown_extensions.attr_list]
[project.markdown_extensions.md_in_html]
[project.markdown_extensions.pymdownx.details]
[project.markdown_extensions.pymdownx.superfences]
custom_fences = [
  { name = "mermaid", class = "mermaid", format = "pymdownx.superfences.fence_code_format" }
]
[project.markdown_extensions.pymdownx.inlinehilite]
[project.markdown_extensions.pymdownx.snippets]
[project.markdown_extensions.pymdownx.highlight]
anchor_linenums = true
linenums = true

[project.markdown_extensions.pymdownx.tasklist]
custom_checkbox = true

[project.markdown_extensions.pymdownx.magiclink]
repo_url_shorthand = true
user = "daemonless"
repo = "daemonless"

[project.markdown_extensions.pymdownx.tabbed]
alternate_style = true

[project.markdown_extensions.pymdownx.emoji]
emoji_index = "zensical.extensions.emoji.twemoji"
emoji_generator = "zensical.extensions.emoji.to_svg"
options.custom_icons = ["overrides/.icons"]

[project.markdown_extensions.zensical.extensions.preview]
targets = { include = ["*.md", "guides/*.md", "guides/dbuild/*.md", "reverse-proxy/*.md", "pkg-cache/*.md"], exclude = ["index.md", "images/index.md", "status.md"] }
